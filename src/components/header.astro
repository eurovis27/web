---
import Navigation from './navigation.astro';
import { Image } from 'astro:assets';
import imageEuroVisLogo from '../assets/logos/logo_eurovis.svg';

interface Props {
  mobileCaption: string;
  colorLightBlue: string;
  colorMediumBlue: string;
  colorAnthracite: string;
  colorOrange: string;
}
const { mobileCaption, colorLightBlue, colorMediumBlue, colorAnthracite, colorOrange } = Astro.props;
---

<!-- CSS -------------------------------------------------------- -->
<style define:vars={{ colorLightBlue, colorMediumBlue, colorAnthracite, colorOrange }}>   

    .banner {
        display:                block;
        position:               relative;
        height:                 8rem;
        margin-top:             2rem;
        margin-bottom:          2rem;
    }

    .logo {
        position:                absolute;
        left:                    15vw;
        bottom:                  0;        
    }

    .logo-image{
        height:                  8rem;
        width:                   auto;
    }    

    .conference {
        position:               absolute;
        right:                  15vw;
        bottom:                 0;
        text-align:             right;        
        color:                  var(--colorMediumBlue);
        font-size:              1.5rem;        
    }

    .title {
        font-family:            var(--font-roboto-condensed-bold), system-ui, -apple-system, sans-serif;         
    }

    .locationdate {
        font-family:            var(--font-roboto-condensed-light), system-ui, -apple-system, sans-serif; 
    }


/***** Additional options for Responsive Web Design *****/
@media screen and (max-width:1250px) {

    .banner {
        height:                 7rem;
    }

    .logo-image {
        height:                 7rem;
    }   

    .conference {
        font-size:              1.3rem;
    }
}        

@media screen and (max-width: 950px) {

    .banner {
        height:                 6rem;
    }

    .logo-image {
        height:                 6rem;
    }   

    .conference {
        font-size:              1.1rem;
    }  
}

@media screen and (max-width: 750px) {

    .logo {
        left:                    10vw;
    }

    .conference {
        right:                  10vw;  
    }

    .banner {
        height:                 3rem;
    }

    .logo-image {
        height:                 3rem;
    }   

    .conference {
        font-size:              0.75rem;
    }  

}

</style>


<!-- HTML ------------------------------------------------------- -->
<header>

    <!-- Banner -->
    <a href={import.meta.env.BASE_URL}>
        <div class="banner">
            <div class="logo">
                <Image
                    src={imageEuroVisLogo}
                    alt="EuroVis Logo Stuttgart"
                    class="logo-image"
                />
            </div>
            <div class="conference">
                <span class="title">
                    The Eurographics Conference on Visualization<br>
                </span>
                <span class="locationdate">
                    Stuttgart, Germany<br>
                    May 31 - June 04, 2027
                </span>
            </div>
        </div>
    </a>

    <Navigation 
      mobileCaption={mobileCaption} 
      colorLightBlue={colorLightBlue}
      colorMediumBlue={colorMediumBlue}
      colorAnthracite={colorAnthracite}
      colorOrange={colorOrange}
    />

</header>
