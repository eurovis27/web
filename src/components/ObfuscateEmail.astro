---
{/* Helper for email address obfuscation. */}

interface Props {
    email: string;
    content?: string
}

const { email, content } = Astro.props;
---

<!-- HTML ------------------------------------------------------- -->

<span>
    <a href={'mailto:'+ email} data-obfuscation>
        <span>
            {content?.trim() ? (
                content
            ) : (
                email
            )}
        </span>
    </a>
    <noscript>JavaScript is required to display the obfuscated email address</noscript>
</span>
