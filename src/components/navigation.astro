---
interface Props {
  pageTitle: string;
  colorLightBlue: string;
  colorMediumBlue: string;
  colorAnthracite: string;
  colorOrange: string;
}
const { pageTitle, colorLightBlue, colorMediumBlue, colorAnthracite, colorOrange } = Astro.props;
---

<!-- CSS -------------------------------------------------------- -->
<style define:vars={{ colorLightBlue, colorMediumBlue, colorAnthracite, colorOrange }}>

    nav {
        display:                flex;
        justify-content:        center;
        align-items:            center;        
        position:               relative;
        margin:                 0;
        padding:                0;
        width:                  100%;
        color:                white;        
        background-color:       var(--colorMediumBlue);
    }
    
    .menu {
        float:                  left;
        padding:                0;
        margin:                 0;    
    }

    .menu button, .menu a {
        display:                block;        
        color:                  white;
        text-decoration:        none;
        transition-property:    color, background-color; 
        transition-duration:    0.25s;
        padding:                0.75rem;          
        font-size:              1.5rem;
        font-weight:            normal;     
        text-transform:         uppercase; 
        font-family:            var(--font-roboto-condensed), system-ui, -apple-system, sans-serif;               
        border:                 none;
        background-color:       var(--colorMediumBlue);
    }    

    .menu a:focus,
    .menu a.active, .menu button.active, /* . not : because added as class via JS*/
    .menu a:hover, .menu button:hover {
        color:                  white;
        background-color:       var(--colorLightBlue);
    }

    .submenu {
        display:                none;        
        float:                  none;
        padding-top:            0;
        font-size:              1.25rem;
        font-weight:            normal;     
        text-transform:         uppercase; 
        font-family:            var(--font-roboto-condensed), system-ui, -apple-system, sans-serif;
        box-shadow:             0.15rem 0.15rem 0.5rem var(--colorAnthracite);
        position:               absolute;
        min-width:              14rem;
    }    

    .submenu a {
        display:                block;        
        color:                  var(--colorMediumBlue);
        background-color:       white;
        text-decoration:        none;
        transition-property:    color, background-color; 
        transition-duration:    0.25s;
        padding:                0.75rem;
    }    

    .submenu a:hover, 
    .submenu a:focus, 
    .submenu a.active,
    .submenu a.visited {
        color:                  white;
        background-color:       var(--colorLightBlue);
    }

    .menu-orga:hover .submenu-orga {
        display: block;
    }
    .menu-prog:hover .submenu-prog {
        display: block;
    }
    .menu-subm:hover .submenu-subm {
        display: block;
    }
    .menu-atte:hover .submenu-atte {
        display: block;
    }
    .menu-colo:hover .submenu-colo {
        display: block;
    }                

    /* Hide all elements that are used for smaller viewport */
    .threeDashMenu {
        display:                none;
    }
    .menuBackground .closeButton {
        display:                none;
    }
    .title {
        display:                none;
    } 

/***** Additional options for Responsive Web Design *****/

@media screen and (max-width: 1080px) {

    /* Switch menu to "three dash icon" and overlay */

    nav {
        justify-content:        left;
        padding-left:           15vw;
    }

    .threeDashMenu {
        display:                flex;
        cursor:                 pointer;
        flex-direction:         column;
        gap:                    0.4rem;
        padding-top:            0.75rem;
        padding-bottom:         0.75rem;
        padding-right:          0.75rem;
        padding-left:           0;
        background-color:       var(--colorMediumBlue);        
        transition-property:    background-color; 
        transition-duration:    0.25s;        
    } 

    .bar {
        width:                  2.5rem;
        height:                 0.4rem;
        background-color:       white;              
    }   

    .menuBackground { 
        height:                 100%;
        width:                  0;
        position:               fixed; 
        z-index:                1;
        left:                   0;
        top:                    0;
        background-color:       rgba(0, 65, 145, 0.9); /* var(--colorMediumBlue); with tranparency */
        overflow-x:             hidden; 
        transition:             0.25s;
        margin:                 0;
        padding-top:            10rem;
    } 

    .menuBackground .closeButton {
        display:                block;
        position:               absolute;
        top:                    0.5rem;
        right:                  3rem;
        margin:                 0;
        padding:                0;            
        font-size:              4rem;
        text-decoration:        none;
        color:                  white;
    } 

    .menu {     
        position:               relative;
        width:                  100%;
        margin-left:            1rem;
    } 

    .menu a, .menu button { 
        width:                  100%;        
        text-align:             left;
        background-color:       rgba(0, 0, 0, 0.0); /* var(--colorMediumBlue); with tranparency */
    }    

    .submenu {     
        position:               relative;
        width:                  100%;
        background-color:       rgba(255, 255, 255);
    }        

    .title {
        display:                block;
        color:                  white;
        font-size:              1.75rem;
        font-weight:            normal;     
        text-transform:         uppercase; 
        font-family:            var(--font-roboto-condensed), system-ui, -apple-system, sans-serif;
        padding-left:           1rem;
    } 
    
    .menu-orga:hover .submenu-orga {
        display: none;
    }
    .menu-prog:hover .submenu-prog {
        display: none;
    }
    .menu-subm:hover .submenu-subm {
        display: none;
    }
    .menu-atte:hover .submenu-atte {
        display: none;
    }
    .menu-colo:hover .submenu-colo {
        display: none;
    }                  
} 

@media screen and (max-width: 720px) {

    nav {
        padding-left:           10vw;
    }
}

</style>

<!-- HTML ------------------------------------------------------- -->
<nav aria-label="Primary navigation">

    <!-- Additional elements for responsive menu on smaller screens  -->
    <div class="threeDashMenu" onclick="openOverlayMenu()">
        <div class="bar"></div>
        <div class="bar"></div>
        <div class="bar"></div>
    </div>
    <div class="title">
        {pageTitle}
    </div>        

    <!-- The navigation menu -->
    <div class="menuBackground" id="menuBackground">
        <!-- Additional elements for responsive menu on smaller screens  -->
        <a href="javascript:void(0)" class="closeButton" onclick="closeOverlayMenu()">&times;</a>

        <div class="menu menu-home">
            <a href={import.meta.env.BASE_URL}>Home</a>
            <div class="submenu submenu-home">

            </div>
        </div>
        
        <div class="menu menu-prog">
            <button onclick="menuButtonClick(this)">Program</button>
            <div class="submenu submenu-prog">
                <a href={import.meta.env.BASE_URL + "program/full-program/"}>Full Porgram</a>
                <a href={import.meta.env.BASE_URL + "program/workshops/"}>Workshops</a>
                <a href={import.meta.env.BASE_URL + "program/invited-speakers/"}>Invited Speakers</a>
                <a href={import.meta.env.BASE_URL + "program/awards/"}>Awards</a>
            </div>
        </div>
        
        <div class="menu menu-subm">
            <button onclick="menuButtonClick(this)">Submissions</button>
            <div class="submenu submenu-subm">
                <a href={import.meta.env.BASE_URL + "submissions/full-papers/"}>Full Papers</a>
                <a href={import.meta.env.BASE_URL + "submissions/short-papers/"}>Short Papers</a>
                <a href={import.meta.env.BASE_URL + "submissions/stars/"}>STARs</a>
                <a href={import.meta.env.BASE_URL + "submissions/posters-demos/"}>Posters & Demos</a>
                <a href={import.meta.env.BASE_URL + "submissions/panels-tutorials/"}>Panels & Tutorials</a>
                <a href={import.meta.env.BASE_URL + "submissions/workshops/"}>Workshops</a>
                <a href={import.meta.env.BASE_URL + "submissions/education-papers/"}>Education Papers</a>
                <a href={import.meta.env.BASE_URL + "submissions/reviewer-guidelines/"}>Reviewer Guidelines</a>
            </div>
        </div>
        
        <div class="menu menu-atte">
            <button onclick="menuButtonClick(this)">Attendance</button>
            <div class="submenu submenu-atte">
                <a href={import.meta.env.BASE_URL + "attendance/registration/"}>Registration</a>
                <a href={import.meta.env.BASE_URL + "attendance/venue-accomodation/"}>Venue & Accomodation</a>
                <a href={import.meta.env.BASE_URL + "attendance/social-events/"}>Social Events</a>
            </div>
        </div>
        
        <div class="menu menu-colo">
            <button onclick="menuButtonClick(this)"><span class="avoidwrap">Co-located Events</span></button>
            <div class="submenu submenu-colo">
                <a href={import.meta.env.BASE_URL + "co-located-events/qivc/"}>QiVC</a>
            </div>
        </div> 

        <div class="menu menu-orga">
            <button onclick="menuButtonClick(this)">Organization</button>
            <div class="submenu submenu-orga">
                <a href={import.meta.env.BASE_URL + "organization/code-of-conduct/"}>Code of Conduct</a>
                <a href={import.meta.env.BASE_URL + "organization/conference-committee/"}>Conference Committee</a>
                <a href={import.meta.env.BASE_URL + "organization/program-committee/"}>Program Committee</a>
                <a href={import.meta.env.BASE_URL + "organization/contact/"}>Contact</a>
            </div>
        </div>        

        <div class="menu menu-arch">
            <a href={import.meta.env.BASE_URL + "archive/"}>Archive</a>
            <div class="submenu submenu-arch">

            </div>
        </div>

    </div>

</nav>

<!-- JAVA SCRIPT ------------------------------------------------ -->
<script is:inline>
    // Inline script to prevent any processing

    document.querySelectorAll("nav a").forEach(link => {
        if (link.pathname === window.location.pathname) {
            link.classList.add("active");
        }
    });

    document.querySelectorAll("nav button").forEach(button => {
        const pathsplit = window.location.pathname.split("/");
        // console.log(pathsplit) 
        // Example: 0: "" | 1: "web" | 2: "organization" | 3: "program-committee" | 4: ""
        let parentpath = button.textContent.toLowerCase();
        parentpath = parentpath.replaceAll(" ", "-");
        if (pathsplit[2].includes(parentpath)) {
            button.classList.add("active");
        }
    });    

    function openOverlayMenu() {
        document.getElementById("menuBackground").style.width = "50%";
    }

    function closeOverlayMenu() {
        document.getElementById("menuBackground").style.width = "0%";
    }     

    function menuButtonClick(clickedButton) {
        if (document.documentElement.clientWidth <= 720) {
            // First, hide all submenus
            submenus = document.getElementsByClassName("submenu");
            for (const submenu of submenus) {
                submenu.style.display = "none";
            }
            // Then, open the current submenu
            menu = clickedButton.parentNode;
            submenu = menu.getElementsByClassName("submenu");
            submenu[0].style.display = "block";
        }
    }

</script>